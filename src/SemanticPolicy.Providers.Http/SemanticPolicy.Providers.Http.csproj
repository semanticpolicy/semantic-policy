<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Decision provider for any server that speaks SemanticPolicy's protocol v0 over HTTP at /v0/decide, such as a classifier you run yourself.</Description>
    <PackageTags>$(PackageTags);protocol-v0;http;self-hosted</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemanticPolicy.Core\SemanticPolicy.Core.csproj" />
  </ItemGroup>

  <!-- The call, the client setup and the status table every HTTP provider shares, compiled in as
       internal types rather than published as an API of their own. -->
  <ItemGroup>
    <Compile Include="..\Shared\ProviderHttp.cs" Link="Shared\ProviderHttp.cs" />
    <Compile Include="..\Shared\ProviderHttpCall.cs" Link="Shared\ProviderHttpCall.cs" />
  </ItemGroup>

</Project>
