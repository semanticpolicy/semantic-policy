<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Decision provider for any server that speaks SemanticPolicy's protocol v0 over HTTP at /v0/decide, such as a classifier you run yourself.</Description>
    <PackageTags>$(PackageTags);protocol-v0;http;self-hosted</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemanticPolicy.Core\SemanticPolicy.Core.csproj" />
  </ItemGroup>

</Project>
