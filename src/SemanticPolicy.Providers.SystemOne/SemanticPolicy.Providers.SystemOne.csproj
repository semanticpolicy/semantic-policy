<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Decision provider for any server that speaks the System One wire at /v1/systemone, such as a decision model you run yourself.</Description>
    <PackageTags>$(PackageTags);systemone;self-hosted</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemanticPolicy.Core\SemanticPolicy.Core.csproj" />
  </ItemGroup>

  <!-- The call, the client setup and the status table every HTTP provider shares, compiled in as
       internal types rather than published as an API of their own. TypeSafe uses this copy through
       InternalsVisibleTo. -->
  <ItemGroup>
    <Compile Include="..\Shared\ProviderHttp.cs" Link="Shared\ProviderHttp.cs" />
    <Compile Include="..\Shared\ProviderHttpCall.cs" Link="Shared\ProviderHttpCall.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SemanticPolicy.Providers.TypeSafe" />
  </ItemGroup>

</Project>
