<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Description>Microsoft.Extensions.AI integration: pre-tool and post-tool policy checks on any IChatClient that runs a function-calling loop.</Description>
    <PackageTags>$(PackageTags);microsoft-extensions-ai;ichatclient;function-calling</PackageTags>
  </PropertyGroup>

  <!-- The package's README is its own, in place of the repository's that Directory.Build.props packs:
       nuget.org shows it to people wiring a chat client, and it explains this package alone. -->
  <ItemGroup>
    <None Remove="$(MSBuildThisFileDirectory)..\..\README.md" />
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SemanticPolicy.Core\SemanticPolicy.Core.csproj" />
  </ItemGroup>

  <!-- The guard machinery every integration shares, compiled in as internal types rather than
       published as an API of its own. -->
  <ItemGroup>
    <Compile Include="..\Shared\Guards\InterventionPoint.cs" Link="Shared\Guards\InterventionPoint.cs" />
    <Compile Include="..\Shared\Guards\GuardSubject.cs" Link="Shared\Guards\GuardSubject.cs" />
    <Compile Include="..\Shared\Guards\PolicyGuard.cs" Link="Shared\Guards\PolicyGuard.cs" />
    <Compile Include="..\Shared\Guards\ToolInvocationGuards.cs" Link="Shared\Guards\ToolInvocationGuards.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SemanticPolicy.Extensions.AI.Tests" />
  </ItemGroup>

</Project>
