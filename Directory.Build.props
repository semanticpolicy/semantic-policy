<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- One version for every project, so the packages and the tools never report different ones. A
       release is tagged v followed by this version. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
  </PropertyGroup>

  <!-- Package metadata for everything under src/. A project that is not published to NuGet turns
       IsPackable off for itself; the defaults live here so the published packages cannot disagree
       about their licence, their repository or who wrote them. -->
  <PropertyGroup>
    <Authors>SemanticPolicy contributors</Authors>
    <Product>SemanticPolicy</Product>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/semanticpolicy/semantic-policy</PackageProjectUrl>
    <RepositoryUrl>https://github.com/semanticpolicy/semantic-policy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- PackageReadmeFile above names README.md; without this item the file is not in the package
       and `dotnet pack` fails with NU5039 rather than shipping a package with no description. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
