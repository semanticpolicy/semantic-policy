<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

  <!-- One version for every project, so the packages and the tools never report different ones. A
       release is tagged v followed by this version. -->
  <PropertyGroup>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>alpha.1</VersionSuffix>
  </PropertyGroup>

  <!-- Package metadata for everything under src/. A project that is not published to NuGet turns
       IsPackable off for itself; the defaults live here so the published packages cannot disagree
       about their licence, their repository or who wrote them. A project appends its own tags to
       PackageTags. -->
  <PropertyGroup>
    <Authors>SemanticPolicy contributors</Authors>
    <Product>SemanticPolicy</Product>
    <PackageTags>ai;ai-agents;llm;policy;prompt-injection;decision-model</PackageTags>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/semanticpolicy/semantic-policy</PackageProjectUrl>
    <RepositoryUrl>https://github.com/semanticpolicy/semantic-policy</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- PackageReadmeFile and PackageIcon above name README.md and icon.png; without these items the
       files are not in the package and `dotnet pack` fails with NU5039 or NU5046 rather than shipping
       a package with no description or no icon. assets/icon.svg is the icon's source; the PNG is it
       rendered at 128 x 128. -->
  <ItemGroup Condition="'$(IsPackable)' != 'false'">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)assets\icon.png" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
