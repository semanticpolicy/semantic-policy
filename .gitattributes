# Text is LF in the repository and in every checkout, Windows included. .editorconfig sets
# end_of_line = lf and dotnet format enforces it, so a native CRLF checkout fails
# `dotnet format --verify-no-changes` on line endings alone and a format run rewrites every file.
# eol=lf takes precedence over core.autocrlf, which Git for Windows turns on by default.
* text=auto eol=lf

*.cs      text diff=csharp
*.csproj  text
*.props   text
*.targets text
*.slnx    text
*.sln     text eol=crlf
*.ps1     text
*.sh      text eol=lf
*.md      text
*.json    text
*.yml     text
*.yaml    text

# The evaluation tool digests a dataset's raw bytes, and a recording replays only against the bytes it was
# made from. LF on every platform keeps a Windows checkout from changing them.
*.jsonl   text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.pdf binary
