# Normalise line endings in the repository. Checkouts stay native, so Windows tooling is unaffected.
* text=auto

*.cs      text diff=csharp
*.csproj  text
*.props   text
*.targets text
*.slnx    text
*.sln     text eol=crlf
*.ps1     text
*.sh      text eol=lf
*.md      text
*.json    text
*.yml     text
*.yaml    text

# The evaluation tool digests a dataset's raw bytes, and a recording replays only against the bytes it was
# made from. LF on every platform keeps a Windows checkout from changing them.
*.jsonl   text eol=lf

*.png binary
*.jpg binary
*.ico binary
*.pdf binary
